      "name": "Ethereum",
      "type": "string",
      "defaultValue": "0x779957e5376571adaf544e63ffc8404e98f30d30",
      "description": "Defaults to the Croptop network's collection. Replace with your own after deploying one (the \"$\" button)."
    },
    "ethereumSepoliaCollectionAddress": {
      "name": "Ethereum Sepolia",
      "type": "string",
      "defaultValue": "0x2b70edc0b7db710f7d8708c6240d6fa9e62b71f5",
