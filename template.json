{
  "name": "Croptop",
  "description": "Publish and access indie content freely through .eth domains",
  "author": "Jango",
  "authorWebsite": "https://croptop.eth.sucks",
  "version": "1.2.2",
  "idealItemsPerPage": 10,
  "generateIndexPagination": false,
  "buildNumber": 598,
  "generateNFTMetadata": true,
  "generateTagPages": true,
  "settings": {
    "maintenanceMessage": {
      "name": "Maintenance Banner",
      "type": "string",
      "defaultValue": "Under maintenance: this site is moving to Juicebox v6. Buying and deploying may not work yet.",
      "description": "Shown at the top of every page. Leave blank to hide."
    },
    "curatorAddress": {
      "name": "Your Address",
      "type": "string",
      "defaultValue": "",
      "description": "The Ethereum address of the curator of this collection where you'll receive rewards."
